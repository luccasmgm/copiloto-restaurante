# Copie para ".env". O .env NUNCA vai para o GitHub (está no .gitignore).

# --- Opção A (recomendada, grátis, sem cartão): Groq ---
# Chave em console.groq.com > API Keys
LLM_API_KEY=sua-chave-aqui
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Opção B (grátis, roda no seu PC): Ollama ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Sem chave nenhuma, o agente funciona em "modo offline" (regras por palavra-chave).
